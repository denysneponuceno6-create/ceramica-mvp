# ============================================================
# Copie para .env  ->  cp .env.example .env
# NUNCA faca commit do arquivo .env
# ============================================================

# Porta local. No Render a porta e injetada automaticamente; nao defina PORT la.
PORT=3000

# production | development
NODE_ENV=development

# String de conexao PostgreSQL (obrigatoria)
DATABASE_URL=postgres://ceramica:ceramica@localhost:5432/ceramica

# SSL do banco: true quando o Postgres for externo/gerenciado (Render, Neon, Supabase).
# Em Postgres local use false.
DATABASE_SSL=false

# Chave de assinatura dos cookies de sessao (obrigatoria, min. 32 caracteres).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=troque-esta-chave-por-uma-aleatoria-de-64-caracteres-no-minimo

# Duracao da sessao em horas
SESSION_HOURS=8

# Cria o schema automaticamente no boot (idempotente). Util no Render Free.
AUTO_MIGRATE=true

# Insere dados ficticios de demonstracao no boot, apenas se o banco estiver vazio.
AUTO_SEED=true

# Senha do usuario administrador criado no seed.
# Se ficar em branco, uma senha aleatoria e impressa no log de deploy uma unica vez.
ADMIN_EMAIL=admin@ceramica.local
ADMIN_PASSWORD=

# Confia no proxy (obrigatorio no Render para cookie secure e rate limit por IP)
TRUST_PROXY=true
