<%- include('../partials/cabeca') %>

<div class="cabecalho-pagina">
  <div>
    <p class="eyebrow">Administração</p>
    <h1><%= titulo %></h1>
  </div>
  <div class="acoes"><a class="btn" href="/usuarios">Voltar para usuários</a></div>
</div>

<section class="cartao">
  <div class="corpo">
    <form method="post" action="<%= usuario.id ? '/usuarios/' + usuario.id : '/usuarios' %>" autocomplete="off">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="campos">
        <div class="campo">
          <label for="nome">Nome completo</label>
          <input type="text" id="nome" name="nome" value="<%= usuario.nome || '' %>" required minlength="3" maxlength="120" autofocus>
        </div>
        <div class="campo">
          <label for="email">E-mail <span class="ajuda">usado para entrar no sistema</span></label>
          <input type="email" id="email" name="email" value="<%= usuario.email || '' %>" required maxlength="180">
        </div>
        <div class="campo">
          <label for="perfil">Perfil de acesso</label>
          <select id="perfil" name="perfil" required>
            <% d.PERFIS.forEach(function (p) { %>
              <option value="<%= p %>" <%= usuario.perfil === p ? 'selected' : '' %>><%= d.ROTULO_PERFIL[p] %></option>
            <% }) %>
          </select>
        </div>
        <div class="campo">
          <label for="senha">
            Senha
            <span class="ajuda"><%= usuario.id ? 'deixe em branco para manter a atual' : 'no mínimo 8 caracteres' %></span>
          </label>
          <input type="password" id="senha" name="senha" <%= usuario.id ? '' : 'required' %> minlength="8" maxlength="200" autocomplete="new-password">
        </div>
        <% if (usuario.id) { %>
        <div class="campo marcador largo">
          <input type="checkbox" id="ativo" name="ativo" <%= usuario.ativo === false ? '' : 'checked' %>>
          <label for="ativo">Usuário ativo — pode entrar no sistema</label>
        </div>
        <% } %>
      </div>
      <div class="acoes-form">
        <button type="submit" class="btn btn-primario" data-carregando="Salvando usuário...">Salvar usuário</button>
        <a class="btn" href="/usuarios">Cancelar</a>
      </div>
    </form>
  </div>
</section>

<%- include('../partials/rodape') %>
