<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="robots" content="noindex, nofollow">
<meta name="theme-color" content="#100E0D">
<title>Entrar &middot; Cerâmica Betim</title>
<link rel="preload" href="/assets/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/manrope-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/css/app.css?v=<%= v %>">
<link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/assets/img/favicon.svg">
</head>
<body class="tela-login">
  <svg xmlns="http://www.w3.org/2000/svg" class="oculto" aria-hidden="true">
    <symbol id="ic-erro" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7.5v5.2M12 16.4v.1"/></symbol>
  </svg>

  <main class="caixa-login">
    <div class="marca-login">
      <img src="/assets/img/marca.svg" alt="" aria-hidden="true">
      <h1>Cerâmica <i>Betim</i></h1>
    </div>
    <p class="subtitulo">Sistema administrativo<br>Produzimos. Organizamos. Entregamos.</p>

    <% if (erro) { %>
      <div class="aviso aviso-erro" role="alert">
        <svg class="i"><use href="#ic-erro"/></svg>
        <span class="texto-aviso"><%= erro %></span>
      </div>
    <% } %>

    <form method="post" action="/login" autocomplete="on">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <input type="hidden" name="proximo" value="<%= typeof proximo !== 'undefined' && proximo ? proximo : '' %>">
      <div class="campo">
        <label for="email">E-mail</label>
        <input type="email" id="email" name="email" value="<%= email %>" required autofocus autocomplete="username" maxlength="180" placeholder="seu.nome@ceramicabetim.com.br">
      </div>
      <div class="campo">
        <label for="senha">Senha</label>
        <input type="password" id="senha" name="senha" required autocomplete="current-password" maxlength="200">
      </div>
      <button type="submit" class="btn btn-primario btn-largo" data-carregando="Entrando...">Entrar no sistema</button>
    </form>

    <p class="rodape-login">
      Ambiente de demonstração com dados fictícios.<br>
      As credenciais de acesso são exibidas no log de inicialização.
    </p>
  </main>

<script src="/assets/js/app.js?v=<%= v %>" defer></script>
</body>
</html>
