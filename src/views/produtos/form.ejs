<%- include('../partials/cabeca') %>

<div class="cabecalho-pagina">
  <div>
    <p class="eyebrow"><%= produto.id ? 'Editar produto' : 'Novo produto' %></p>
    <h1><%= titulo %></h1>
  </div>
  <div class="acoes"><a class="btn" href="/produtos">Voltar para produtos</a></div>
</div>

<section class="cartao">
  <div class="corpo">
    <form method="post" action="<%= produto.id ? '/produtos/' + produto.id : '/produtos' %>">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="campos">
        <div class="campo largo">
          <label for="nome">Nome do produto</label>
          <input type="text" id="nome" name="nome" value="<%= produto.nome || '' %>" required minlength="3" maxlength="140" autofocus placeholder="Tijolo 6 furos 9x14x24">
        </div>
        <div class="campo">
          <label for="unidade">Unidade de venda</label>
          <input type="text" id="unidade" name="unidade" value="<%= produto.unidade || 'milheiro' %>" required maxlength="20" placeholder="milheiro">
        </div>
        <div class="campo">
          <label for="preco">Preço por unidade (R$)</label>
          <input type="text" id="preco" name="preco" value="<%= produto.preco || '0' %>" required inputmode="decimal" placeholder="850,00">
        </div>
        <div class="campo">
          <label for="estoque_minimo">Estoque mínimo <span class="ajuda">para o aviso de reposição</span></label>
          <input type="number" id="estoque_minimo" name="estoque_minimo" value="<%= produto.estoque_minimo || 0 %>" min="0" step="1">
        </div>
        <% if (produto.id) { %>
        <div class="campo marcador largo">
          <input type="checkbox" id="ativo" name="ativo" <%= produto.ativo === false ? '' : 'checked' %>>
          <label for="ativo">Produto ativo — aparece na lista ao criar pedidos</label>
        </div>
        <% } %>
      </div>
      <div class="acoes-form">
        <button type="submit" class="btn btn-primario" data-carregando="Salvando produto...">Salvar produto</button>
        <a class="btn" href="/produtos">Cancelar</a>
      </div>
    </form>
  </div>
</section>

<%- include('../partials/rodape') %>
